@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap');
:root{--ink:#151515;--muted:#77736e;--paper:#f1eee8;--white:#fffdfa;--line:#d6d0c7;--red:#a52b24;--max:1320px}
*{box-sizing:border-box}html{scroll-behavior:smooth;scroll-padding-top:90px}body{margin:0;background:var(--paper);color:var(--ink);font:15px/1.7 'DM Sans',Arial,sans-serif}a{color:inherit;text-decoration:none;transition:color .2s ease}a:hover{color:var(--red)}img{max-width:100%;display:block}.wrap{width:min(var(--max),calc(100% - 64px));margin-inline:auto}
.site-header{height:76px;background:var(--ink);color:#f8f4ed;position:sticky;top:0;z-index:30;border-bottom:1px solid #393633}.header-inner{height:100%;display:flex;align-items:center;justify-content:space-between;gap:28px}.brand{font-size:15px;line-height:1.1;font-weight:700;letter-spacing:.17em;white-space:nowrap;color:#fff}.brand small{display:block;color:#b7aea2;font-size:8px;letter-spacing:.38em;font-weight:500;margin-top:7px}.nav{display:flex;align-items:center;gap:clamp(12px,1.65vw,25px);font-size:11px;font-weight:600;letter-spacing:.025em}.nav a{white-space:nowrap;color:#e7e1d9}.nav a:hover{color:#d18b7f}.menu-toggle{display:none;color:#fff;border:1px solid #666;background:transparent;padding:7px 12px;font-size:20px}
.hero{position:relative;overflow:hidden;background:#171717;color:#f7f2ea;padding:clamp(82px,10vw,145px) 0 105px;border-bottom:5px solid var(--red)}.hero:before{content:"";position:absolute;inset:0 0 0 52%;background:linear-gradient(90deg,#171717 0%,rgba(23,23,23,.65) 30%,rgba(23,23,23,.18) 100%),repeating-linear-gradient(135deg,rgba(255,255,255,.035) 0 1px,transparent 1px 11px);opacity:.8}.hero .wrap{position:relative;z-index:1}.hero .eyebrow,.page-intro .eyebrow{color:#c76d60}.hero h1{font:600 clamp(54px,9.2vw,128px)/.9 'Playfair Display',Georgia,serif;letter-spacing:-.055em;margin:26px 0 28px;max-width:940px}.hero h1 br{display:block}.hero .lead{color:#c9c2b8;font-size:clamp(17px,2vw,22px);max-width:620px}.hero-actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:36px}
.eyebrow{text-transform:uppercase;letter-spacing:.2em;font-size:10px;font-weight:700;color:var(--red)}h1,h2,h3,p{margin-top:0}h1{font:600 clamp(40px,6vw,76px)/1.02 'Playfair Display',Georgia,serif;letter-spacing:-.04em;margin:16px 0 22px;max-width:1000px}h2{font:600 clamp(30px,4vw,49px)/1.08 'Playfair Display',Georgia,serif;letter-spacing:-.035em;margin-bottom:20px}h3{font-size:18px;line-height:1.3}
.lead{font-size:clamp(17px,2vw,21px);max-width:720px;color:#615d57}.button{display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:12px 22px;border:1px solid var(--ink);font-size:11px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;transition:background .25s,color .25s,border .25s}.button.primary{background:var(--red);border-color:var(--red);color:#fff}.hero .button{border-color:#a9a198;color:#f8f4ed}.hero .button.primary{background:var(--red);border-color:var(--red)}.button:hover,.hero .button:hover{background:#f5eee5;border-color:#f5eee5;color:#151515}
.section{padding:clamp(58px,7vw,96px) 0;border-bottom:1px solid var(--line)}.section-head{display:flex;justify-content:space-between;align-items:end;gap:30px;margin-bottom:38px}.section-head h2{margin:8px 0 0}.section-head p{max-width:470px;color:var(--muted);margin:0;font-size:13px}
.film-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:34px 22px}.film-card{min-width:0}.poster{aspect-ratio:2/3;background:#d9d4cb;position:relative;overflow:hidden;border:0}.poster img{width:100%;height:100%;object-fit:contain;background:#d9d4cb;transition:transform .7s cubic-bezier(.2,.7,.2,1)}.film-card:hover .poster img{transform:scale(1.035)}.poster-placeholder{height:100%;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:22px;text-align:center;color:#6d665d;background:linear-gradient(145deg,#dcd5ca,#c8bfb2)}.poster-placeholder strong{font-size:11px;letter-spacing:.18em}.poster-placeholder span{font-size:12px;margin-top:10px}.film-card h3{font:600 21px/1.25 'Playfair Display',Georgia,serif;margin:16px 0 5px}.meta{font-size:11px;color:var(--muted);letter-spacing:.035em}.film-card a:hover h3{color:var(--red)}
.two-col{display:grid;grid-template-columns:1fr 1fr;gap:clamp(36px,7vw,100px);align-items:start}.two-col p{color:#5e5a54;max-width:650px}.service-list{list-style:none;padding:0;margin:0;border-top:1px solid var(--line)}.service-list li{display:flex;justify-content:space-between;gap:20px;padding:17px 0;border-bottom:1px solid var(--line);font-size:13px}.service-list li span:last-child{color:var(--red);font-size:11px;white-space:nowrap}.platforms{display:grid;grid-template-columns:repeat(4,1fr);border-top:1px solid var(--line);border-left:1px solid var(--line)}.platforms>div{padding:20px 18px;border-right:1px solid var(--line);border-bottom:1px solid var(--line);font:600 17px 'Playfair Display',Georgia,serif;background:rgba(255,255,255,.2)}
.cta{background:#1a1918;color:#f8f4ed;padding:clamp(32px,5vw,64px)}.cta p{color:#bdb5aa;max-width:560px}.cta .eyebrow{color:#ce786b}.cta .button{background:var(--red);border-color:var(--red);color:white}
.page-intro{padding:72px 0 50px;background:#1a1918;color:#f7f2ea;border-bottom:4px solid var(--red)}.page-intro .meta{color:#c7bfb5}.content{padding:58px 0 90px}.film-detail{display:grid;grid-template-columns:minmax(250px,390px) 1fr;gap:clamp(34px,6vw,86px);align-items:start}.film-detail>.poster{position:sticky;top:105px;box-shadow:0 18px 42px rgba(20,18,15,.12)}.film-detail h2{margin-top:8px}.film-detail p{color:#57534d;max-width:760px}.facts{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:0 24px;margin:28px 0;border-top:1px solid var(--line)}.fact{padding:13px 0;border-bottom:1px solid var(--line);display:flex;flex-direction:column;gap:3px}.fact b{font-size:10px;letter-spacing:.1em;text-transform:uppercase;color:var(--muted)}.fact span{font-size:13px}.platform-links{display:flex;flex-wrap:wrap;gap:9px;margin-top:18px}.platform-links a{border:1px solid var(--line);padding:9px 13px;font-size:11px;font-weight:600}.platform-links a:hover{border-color:var(--red);color:var(--red)}
.price-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1px;background:var(--line);border:1px solid var(--line)}.price-card{background:var(--white);padding:26px;min-height:210px}.price-card h3{font:600 20px 'Playfair Display',Georgia,serif}.price-card .price{font:600 29px 'Playfair Display',Georgia,serif;color:var(--red);margin:12px 0}.price-card p{font-size:12px;color:var(--muted)}.note{padding:16px 19px;border-left:3px solid var(--red);background:#e8e2d9;color:#5c554d;font-size:12px}
.form-box{background:var(--white);border:1px solid var(--line);padding:clamp(20px,4vw,38px);margin-top:24px}.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:18px}.field{display:flex;flex-direction:column;gap:7px}.field.full{grid-column:1/-1}.field label{font-size:11px;font-weight:700;letter-spacing:.04em}.field input,.field select,.field textarea{width:100%;border:1px solid #cfc8bd;background:#fff;padding:13px 14px;font:14px 'DM Sans',sans-serif;border-radius:0;color:var(--ink)}.field textarea{min-height:110px;resize:vertical}.field input:focus,.field textarea:focus,.field select:focus{outline:1px solid var(--red);border-color:var(--red)}.check{display:flex;align-items:flex-start;gap:10px;font-weight:400!important;letter-spacing:0!important}.check input{margin-top:4px}.form-status{font-size:11px;color:var(--muted);margin:10px 0 0}.footer{background:#151515;color:#f5f0e8;padding:54px 0 24px}.footer-grid{display:grid;grid-template-columns:2fr 1fr 1fr;gap:36px}.footer p,.footer a{color:#c2bbb1;font-size:12px}.footer h3{font:600 17px 'Playfair Display',Georgia,serif}.footer-bottom{border-top:1px solid #3b3834;margin-top:38px;padding-top:18px;color:#8e877e;font-size:10px;display:flex;justify-content:space-between;gap:20px;flex-wrap:wrap}.footer-links{display:flex;gap:14px;flex-wrap:wrap}.footer a:hover{color:white}
@media(max-width:1050px){.nav{gap:11px;font-size:10px}.brand{font-size:13px}.film-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:34px 24px}.platforms{grid-template-columns:repeat(3,1fr)}}
@media(max-width:760px){.wrap{width:min(var(--max),calc(100% - 36px))}.site-header{height:68px}.menu-toggle{display:block}.nav{display:none;position:absolute;top:68px;left:0;right:0;background:#171717;padding:18px 22px 24px;align-items:stretch;flex-direction:column;gap:0;border-top:1px solid #393633}.nav.open{display:flex}.nav a{padding:12px 0;border-bottom:1px solid #373431;font-size:12px}.hero{padding:76px 0 72px}.hero:before{inset:0;opacity:.45}.hero h1{font-size:clamp(48px,15vw,80px)}.section{padding:56px 0}.section-head{align-items:start;flex-direction:column;gap:12px;margin-bottom:26px}.film-grid{gap:27px 14px}.film-card h3{font-size:18px}.two-col{grid-template-columns:1fr;gap:30px}.platforms{grid-template-columns:repeat(2,1fr)}.platforms>div{padding:16px 12px;font-size:15px}.page-intro{padding:55px 0 36px}.content{padding:35px 0 60px}.film-detail{grid-template-columns:1fr;gap:28px}.film-detail>.poster{position:static;width:min(78%,380px);margin:0 auto}.facts{grid-template-columns:1fr 1fr}.price-grid{grid-template-columns:1fr}.price-card{min-height:0}.form-grid{grid-template-columns:1fr}.field.full{grid-column:auto}.footer-grid{grid-template-columns:1fr;gap:22px}.footer-bottom{flex-direction:column}.cta{padding:28px 22px}}
@media(prefers-reduced-motion:reduce){*,*:before,*:after{scroll-behavior:auto!important;transition:none!important;animation:none!important}}

/* Official social brand marks */
.footer-links a:has(.social-icon){display:inline-flex;align-items:center;gap:8px}
.social-icon{width:18px;height:18px;object-fit:contain;display:inline-block;vertical-align:middle}
.film-card .poster img{display:block;object-fit:cover}
